# Application mode: development | test | production
MODE=development

# Public site metadata and URL. NEXT_PUBLIC_APP_URL must be a full URL including
# the port, e.g. http://localhost:3100. It is the single source of truth for the
# port: the dev and start scripts in package.json pass the same number to Next,
# Better Auth derives its trusted loopback origins from it, and Playwright uses
# it as the base URL. Change the port here AND in those two scripts.
NEXT_PUBLIC_APP_TITLE=
NEXT_PUBLIC_APP_DESCRIPTION=
# IANA timezone the app renders dates and times in.
# Optional; defaults to Australia/Adelaide. Set it deliberately per project.
NEXT_PUBLIC_APP_TIME_ZONE=Australia/Adelaide
NEXT_PUBLIC_APP_URL=

# Database connection string (Postgres). Keep sslmode=verify-full on it.
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_NAME=
# DATABASE_HOST=
# DATABASE_PORT=
DATABASE_URL=

# Auth (Better Auth). The secret must be at least 32 characters.
BETTER_AUTH_SECRET=
# Cookie name prefix. Must be a NON-EMPTY string - the client env schema requires
# at least one character, so leaving this blank stops the app starting.
NEXT_PUBLIC_BETTER_AUTH_COOKIE_PREFIX=portal

# Password length bounds (kept in sync between the client Zod schemas and Better Auth)
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=8
NEXT_PUBLIC_PASSWORD_MAX_LENGTH=30

# --- Email ----------------------------------------------------------
# Address emails are sent from (an Azure Communication Services sender address)
EMAIL_FROM_ADDRESS=
# Azure Communication Services connection - only needed when actually sending.
# Uncomment and fill these in when EMAIL_SEND_ENABLED=true.
# EMAIL_AZURE_ENDPOINT=
# EMAIL_AZURE_ACCESS_KEY=
# Master switch: "true" sends real emails (any environment), "false" logs them instead.
EMAIL_SEND_ENABLED=false

# --- Testing --------------------------------------------------------
# Optional: directory for Playwright E2E artefacts. Keep it OFF any OneDrive-synced
# path (OneDrive locks files -> EPERM). Defaults to the OS temp dir when unset.
# E2E_OUTPUT_DIR=

# Base64-encoded 32-byte key for field-level encryption of sensitive data at
# the application layer. Nothing in the base encrypts anything today, so this is
# free to set now - but once a project encrypts its first value it can never be
# changed without making that value unreadable. Unrelated to 2FA, which Better
# Auth encrypts under BETTER_AUTH_SECRET.
# Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Data retention (see docs/security.md) --------------------------
# Bearer token the monthly job endpoint requires. Until it is set, the endpoint
# is inert. In production this lives in Key Vault (referenced by the App Service
# setting); the Azure Logic App scheduler reads the same secret to call the
# endpoint. This local value is only for local testing. Generate: openssl rand -base64 32
# RETENTION_JOB_SECRET=
# Master switch. "false" (default) = the job only previews and changes nothing.
# Set "true" ONLY after the retention policy is signed off - from then on dormant
# accounts are de-identified for real, and that cannot be undone.
RETENTION_JOB_ENABLED=false
# Activity/audit log retention in days. The monthly job deletes audit_logs older
# than this. Defaults to 180. Set to 0 to keep the audit trail indefinitely.
# Keep it LONGER than the 12-month inactivity window: sign-in audit events are
# the only evidence of activity the de-identification sweep has, so purging them
# early makes active accounts look dormant.
AUDIT_LOG_RETENTION_DAYS=180

# --- AI chat (Amazon Bedrock) ---------------------------------------
# An Amazon Bedrock API key - a BEARER TOKEN, not an access-key/secret pair.
# The AWS SDK reads this exact variable name itself, so it cannot be renamed.
# Leave it unset to run without AI chat: the screen then explains it is not
# configured and the endpoint answers 503, rather than failing at send time.
#
# The region (ap-southeast-2) and model (au.anthropic.claude-opus-4-6-v1) are
# PINNED in src/lib/ai/bedrock-client.ts and deliberately not configurable -
# the key is locked to Australia, and making them env-driven is how a deploy
# ends up routing inference offshore. Bedrock API keys expire and can be
# revoked; a run of AccessDenied errors means the key, not the code.
# AWS_BEARER_TOKEN_BEDROCK=
#
# Chat retention in days. The monthly job deletes conversations idle longer
# than this, and their messages cascade. Defaults to 365. Set to 0 to keep
# chat history indefinitely.
AI_CHAT_RETENTION_DAYS=365
#
# Request-log retention in days, for the admin "AI requests" screen. Kept much
# shorter than the chats themselves on purpose: that table stores the full text
# of every request for admins to read, and because each send logs the WHOLE
# conversation, it grows with the SQUARE of thread length. Defaults to 30. Set
# to 0 to keep it forever, and watch the table size if you do.
AI_CHAT_LOG_RETENTION_DAYS=30
#
# How long a file that was uploaded to the chat but never sent is kept, in
# HOURS. Somebody attached something and closed the tab: nothing else will
# ever collect it, because the message and conversation cascades only reach a
# file once it belongs to a turn. Defaults to 24. Set to 0 to keep them
# forever, which is only sensible while debugging.
AI_CHAT_STAGED_ATTACHMENT_HOURS=24

# --- Attachment storage (Azure Blob) ---------------------------------
# Where chat attachment BYTES live. The database holds only metadata and a
# pointer, because steady-state usage is roughly a file per user per day
# against the retention window above, and Azure Postgres storage cannot be
# shrunk once grown.
#
# Leave unset to run without file attachments: chat still works and the
# composer simply does not offer the paperclip.
#
# The container is created on first use and is PRIVATE. Never enable
# anonymous read on it - the access check that protects these files lives in
# the download route, and a public container routes straight around it.
#
# LOCAL DEVELOPMENT uses Azurite, Microsoft's emulator: run `pnpm dev:storage`
# in a second terminal and use the line below verbatim. That account key is a
# published constant that ships with the emulator, which is why it is safe to
# commit here and why it must NEVER appear in a real environment.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
#
# In production this is a real storage account connection string, and it
# belongs in Key Vault like every other secret.
# Container name. Optional; defaults to ai-chat-attachments.
# AZURE_STORAGE_ATTACHMENT_CONTAINER=ai-chat-attachments

# --- Meeting transcription (Azure AI Speech) --------------------------
# Turns a recorded or uploaded meeting into a transcript, then has Bedrock
# summarise it. Two separate things have to be configured and they fail
# differently, which is why the screen reports them separately:
#
#   1. AZURE_STORAGE_CONNECTION_STRING above. The SAME storage account as
#      chat attachments, a different container. Without it there is nowhere
#      to put a recording and the feature says so.
#   2. The Speech resource below. Without it a recording can be stored but
#      nothing will ever transcribe it.
#
# Recordings are KEPT for TRANSCRIPTION_RETENTION_DAYS so they can be
# downloaded, then removed with their row. Budget for it: roughly 20-30 MB
# per hour of recorded audio, so ten people recording four hours a month
# settles at a few gigabytes - pennies a month on hot blob storage.
#
# Container name for the media. Optional; defaults to transcription-media.
# Keep it separate from the attachment container: the retention sweep
# deletes anything in here that no transcription row claims.
# AZURE_MEDIA_CONTAINER=transcription-media
#
# The Speech resource's key and region. Create a Speech resource in an
# Australian region (australiaeast) so meeting audio does not leave the
# country, and put the key in Key Vault like every other secret.
#
# THE SPEECH RESOURCE MUST BE ABLE TO READ THE STORAGE ACCOUNT. The app hands
# it a plain blob URL with no SAS token on it, and the service reads it with
# its own managed identity - so give that identity the "Storage Blob Data
# Reader" role on the storage account. Without it, jobs fail with an access
# error rather than transcribing silence. See docs/deployment.md.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=australiaeast
#
# The spoken language, as a BCP-47 tag. Batch transcription is told one
# language up front; it does not detect it. Defaults to en-AU.
# AZURE_SPEECH_LOCALE=en-AU
#
# Transcription retention in days. The monthly job deletes transcriptions
# older than this along with any recording still held for them. Defaults to
# 90 - shorter than chat, because a meeting transcript is a record of other
# people who did not choose to be recorded. Set to 0 to keep them forever.
TRANSCRIPTION_RETENTION_DAYS=90

# --- Push notifications (Web Push) -----------------------------------
# Tells somebody a transcription is ready while the app is closed.
#
# Generate the pair ONCE and keep both halves together:
#   pnpm exec web-push generate-vapid-keys
#
# They are a MATCHED PAIR - the public key is what a browser subscribes
# with, and the private key is what proves the sender of a message is the
# same party. One without the other is useless, and there is no way to look
# a lost half up: regenerate, and every existing subscription dies silently.
# Every device that had notifications on goes quiet, and nothing can tell
# those people to turn it back on, because notifications are what broke.
#
# THE PUBLIC KEY IS NOT AN APP SERVICE SETTING. Like every NEXT_PUBLIC_
# value it is compiled into the browser bundle when CI builds, so in a
# deployed environment it belongs in a GitHub repo Variable. Setting it in
# Azure does nothing at all and the toggle simply never appears.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
#
# The private half. A real secret - Key Vault in a deployed environment,
# and never in a NEXT_PUBLIC_ variable.
# VAPID_PRIVATE_KEY=
#
# Identifies the sender to the push service so it has somebody to contact
# about a misbehaving one. A mailto: or https: URL. Defaults to a
# placeholder that is fine locally and wrong in production.
# VAPID_SUBJECT=mailto:you@example.com
#
# Bearer token for POST /api/jobs/transcription-sweep, which advances
# everybody's unfinished transcriptions. Minimum 16 characters; the
# endpoint answers 503 until it is set.
#
# WITHOUT SOMETHING CALLING THAT ENDPOINT ON A TIMER, notifications cannot
# fire at all. Jobs only move forward while somebody has the transcription
# screen open, so with a locked phone nothing finishes the job and there is
# nothing to notify about. See docs/deployment.md.
# TRANSCRIPTION_SWEEP_SECRET=

# --- Microsoft sign-in (Entra ID) ------------------------------------
# Optional to the schema, but it is the ONLY way into a real environment.
# With these unset the "Continue with Microsoft" button does not render and,
# unless DEV_PASSWORD_SIGN_IN below is on, the sign-in page has nothing on it
# and nobody can get in. That is a misconfiguration, not a supported mode.
#
# From the Entra app registration (see docs/deployment.md):
#   CLIENT_ID     = Application (client) ID
#   TENANT_ID     = Directory (tenant) ID  -- your own tenant GUID
#   CLIENT_SECRET = the secret VALUE (not the Secret ID), shown once
#
# TENANT_ID must be your tenant, never "common". Better Auth defaults to
# "common", which accepts any Microsoft account in the world including
# personal outlook.com ones - leaving the domain allowlist below as the only
# thing standing between those and your app.
#
# Redirect URI to register in Entra:
#   https://<your-app>/api/auth/callback/microsoft
# MICROSOFT_CLIENT_ID=
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_SECRET=

# Comma-separated bare domains allowed to hold an account, e.g.
# "example.com,example.org". Enforced on account CREATION for every sign-in
# method, in src/lib/auth/account-creation-policy.ts.
#
# This is NOT redundant with a single-tenant Entra app: B2B guest users live
# inside your tenant with their own external addresses, and a single-tenant
# app authenticates them happily.
#
# Unset means no restriction - correct for a base repo that knows nothing
# about the organisation deploying it, and almost never correct for a real
# deployment. Set it.
# AUTH_ALLOWED_EMAIL_DOMAINS=

# --- Password sign-in: LOCAL DEVELOPMENT ONLY ------------------------
# Opens a password form on /sign-in so the app can be run without an Entra
# app registration. IGNORED unless MODE is development or test, so copying
# this file to a production environment cannot open a password door.
#
# It opens a door but hands out no keys: there is no sign-up and no password
# reset. Create an account with
#
#   $env:DEV_USER_EMAIL = "you@example.com"
#   node --env-file=.env scripts/create-dev-user.mjs
#
# Leave it unset for any environment that matters.
# DEV_PASSWORD_SIGN_IN=true

# --- App-level two-factor authentication -----------------------------
# A second factor on THIS APP, on top of the Microsoft sign-in. Off by
# default, and that default matters: turning it on requires every user to
# enrol an authenticator before they can reach any part of the app, so
# deploying must never do it on its own. Turn it on deliberately, after
# people have been told.
#
# WHY IT EXISTS. Enforcing MFA in Entra needs a Conditional Access policy,
# which needs an Entra ID P1 licence per user. This is the alternative for a
# tenant on the free tier.
#
# WHAT IT IS NOT. It does not make the tenant two-factor. A stolen password
# still reaches email, Teams and SharePoint, because the identity itself is
# unchanged. What it protects is the data in here - chat transcripts,
# meeting recordings, uploaded files. Do not call it "we have MFA"; it is
# "the portal requires a second factor".
#
# If the organisation later buys P1, turn this OFF and use a Conditional
# Access policy instead. Two prompts for the same thing trains people to
# click through both.
# APP_TWO_FACTOR_ENABLED=true

# --- Jira timesheet sync (see docs/timesheet-sync.md) ---------------
# The Jira Cloud site, with no trailing path, e.g. https://yourteam.atlassian.net
JIRA_BASE_URL=
# The account the API token belongs to. This MUST be a dedicated service
# account, never a person's own login: a personal token stops working the day
# that account is deactivated, and the failure mode is billing quietly
# stopping rather than anything visibly breaking. It needs Browse Projects on
# every space plus the time tracking permissions, and nothing more - the sync
# never writes to Jira.
JIRA_EMAIL=
# In production this lives in Key Vault, referenced by the App Service setting.
JIRA_API_TOKEN=

# Custom field ids, e.g. customfield_10050. Jira exposes custom fields by id
# rather than by name, and the ids differ per site, so they are configuration.
# Find them at: {JIRA_BASE_URL}/rest/api/3/field
# Left blank, the sync still runs and these attributes come back empty, which
# shows up as audit findings rather than as a crash.
JIRA_FIELD_BILLABLE=
JIRA_FIELD_CATEGORY=
# Optional. A baseline estimate held in a custom field, in HOURS. Without it
# the baseline falls back to Jira's own original estimate.
JIRA_FIELD_BASELINE_ESTIMATE=

# Bearer token the sync trigger endpoint requires. Until it is set the
# endpoint is inert (503). The Logic App timer reads the same secret to call
# it. Generate: openssl rand -base64 32
# JIRA_SYNC_SECRET=
# Master switch. "false" (default) = the job reads Jira and reports what it
# WOULD write, changing nothing. Set "true" once a dry run looks right.
JIRA_SYNC_ENABLED=false
# Minutes re-read on every run, to cover clock skew between this app and Jira.
# Overlap is free (writes are upserts keyed on Jira's worklog id); a gap loses
# billable time silently. Err upward.
JIRA_SYNC_OVERLAP_MINUTES=10
# Where a first-ever run starts reading from, YYYY-MM-DD. Only used when no
# watermark exists yet. Defaults to 90 days ago.
# JIRA_SYNC_START_DATE=

# The first day this organisation kept time in Jira, YYYY-MM-DD.
#
# A DISPLAY and MEASUREMENT floor, and deliberately not the same setting as
# JIRA_SYNC_START_DATE above: that one decides what the sync FETCHES, this one
# decides what the screens SHOW and what utilisation is measured against.
# Before this date there are no worklogs, so counting contracted hours for
# those days reports a shortfall that never happened.
#
# The back arrow stops at the first period on record, and a period straddling
# this date says so rather than presenting a part month as a whole one.
#
# Unset means no floor - the right default, since a fresh project has no such
# date. Falls back to JIRA_SYNC_START_DATE when that is set.
# TIMESHEET_HISTORY_START=

# -----------------------------------------------------------------------------
# SharePoint inventory
# -----------------------------------------------------------------------------
# Bearer token for POST /api/jobs/sharepoint-crawl-sweep, which carries every
# unfinished crawl forward. Minimum 16 characters; the endpoint answers 503
# until it is set.
#
# A CRAWL CANNOT FINISH WITHOUT SOMETHING CALLING THAT ENDPOINT. Pressing
# "Crawl now" only queues a row - a large library is hundreds of Graph pages,
# far too much work to hold a request open for. One call walks up to 25 pages
# and saves its place, so a timer every minute or two is what actually
# finishes the job. In local development, curl it by hand.
#
# The SharePoint feature also needs the MICROSOFT_* variables above, and the
# app registration needs the DELEGATED Graph permissions Sites.Read.All and
# Files.Read.All with tenant admin consent granted. Every crawl runs on one
# person's delegated token, so it can never read a library that person could
# not already open themselves.
# SHAREPOINT_SWEEP_SECRET=

# How long a record of a crawl RUN is kept, in days. Defaults to 180.
# Set to 0 to keep them indefinitely.
#
# NOT the inventory itself. A file path is only disclosive while it describes
# something that exists, and ageing live rows out would just force a full
# re-crawl to rebuild identical data - more Graph traffic, same exposure. What
# removes an inventory is an admin de-nominating its library, which cascades.
# SHAREPOINT_INVENTORY_RETENTION_DAYS=180
