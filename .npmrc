# Install a flat, symlink-free node_modules (npm-style) instead of pnpm's default
# symlinked .pnpm store.
#
# Next.js `output: "standalone"` copies node_modules into the deploy package. With
# pnpm's default linker, node_modules/<pkg> is a symlink into the .pnpm store; when
# that package is tar/zipped for Azure App Service the symlink gets flattened into a
# text file containing the link target, and Node then tries to execute that path as
# JavaScript, failing with:
#   SyntaxError: Unexpected token '.'   (e.g. reading `.pnpm/next@.../node_modules/next`)
# Hoisted linking produces real files that survive packaging on any platform.
node-linker=hoisted
